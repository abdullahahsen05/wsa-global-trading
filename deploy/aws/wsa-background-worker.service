[Unit]
Description=WSA Global background jobs worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=wsa
WorkingDirectory=/opt/wsa/app
ExecStart=/bin/bash /opt/wsa/app/deploy/aws/wsa-worker-start.sh jobs
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
