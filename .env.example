# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Database password (for migration runner only)
SUPABASE_DB_PASSWORD=your-db-password

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Billing / Payments
# Set BILLING_PROVIDER=mock for local/CI testing (no Stripe calls).
# Set BILLING_PROVIDER=stripe to use Stripe Checkout in production.
BILLING_PROVIDER=mock

# Stripe (required when BILLING_PROVIDER=stripe)
# Use sk_test_... / pk_test_... for test mode, sk_live_... / pk_live_... for production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs - create these in Stripe Dashboard or run: npx tsx scripts/setup-stripe-products.ts
STRIPE_PRICE_PLATFORM_MONTHLY=
STRIPE_PRICE_COPY_NORMAL_MONTHLY=
STRIPE_PRICE_COPY_ULTRA_FAST_MONTHLY=
STRIPE_PRICE_BOT_EA_ONE_TIME=
STRIPE_PRICE_MENTORSHIP_ONE_TIME_EUR=

# Optional: enable Stripe E2E Playwright tests (requires real test credentials + stripe listen)
STRIPE_E2E_ENABLED=false

# Broker integration (paid MT5 API / API2Trade-compatible flow)
BROKER_PROVIDER=api2trade
# Auth mode:
# - basic  => username/password against the paid MT5 Swagger host
# - apikey => legacy API-key account mode
API2TRADE_AUTH_MODE=basic
API2TRADE_BASE_URL=https://mt5.mt4api.dev
API2TRADE_USERNAME=
API2TRADE_PASSWORD=
# Optional for legacy API-key mode only.
API2TRADE_API_KEY=
# Optional websocket/events override; leave blank to derive from base URL.
API2TRADE_EVENTS_URL=
# Optional compatibility flag for old dashboard-UUID account flows.
API2TRADE_CONNECTION_MODE=
# Live copy-trading order execution master switch. Leave false until you have
# verified execution on a DEMO MT5 account. When false, live copy returns
# COPY_EXECUTION_NOT_CONFIGURED (no orders are ever placed).
BROKER_EXECUTION_ENABLED=false

# Background worker / job queue
# Shared secret required (in production) to call /api/worker/jobs/* - set this to
# a long random string and pass it as the `x-worker-secret` header (e.g. from Vercel Cron).
WORKER_SECRET=
# Max jobs processed per worker run (hard-capped at 20).
WORKER_MAX_JOBS_PER_RUN=5
# Minutes before a stuck RUNNING job is released by CLEANUP_STALE_JOBS.
WORKER_STALE_JOB_MINUTES=15

# Encryption key for broker credentials (AES-256-GCM via SHA-256 derivation).
# Required to store MT5 credentials. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Copy / risk workers
WSA_COPY_ENGINE_ENABLED=true
WSA_RISK_ENGINE_ENABLED=true
WSA_COPY_POLL_MS=100
WSA_JOB_POLL_MS=2000
WSA_ACCOUNT_SYNC_INTERVAL_MS=300000
WSA_EVALUATION_INTERVAL_MS=300000
WSA_COPY_EXECUTION_PRIORITY_MS=4000
WSA_COPY_RUNTIME_CACHE_MS=300000
WSA_COPY_PREMIUM_ULTRA_FAST=true
WSA_COPY_TIMING_LOGS=true
WSA_COPY_DIRECT_EXECUTION=true
API2TRADE_WEBSOCKET_ENABLED=true
API2TRADE_WS_FALLBACK_POLL_MS=2000
API2TRADE_WARM_SESSION_TTL_MS=300000

# Market Data Terminal
# Default provider is "mock" - demo data, no credentials needed.
# To enable institutional dxFeed data: set MARKET_DATA_PROVIDER=dxfeed and all DXFEED_* vars.
MARKET_DATA_PROVIDER=mock
DXFEED_ENABLED=false
DXFEED_API_BASE_URL=
DXFEED_API_KEY=
DXFEED_ACCOUNT_ID=
DXFEED_ENVIRONMENT=demo
# Set to "true" while using mock provider so the UI clearly labels data as demo.
NEXT_PUBLIC_TERMINAL_DEMO_MODE=true

# dxFeed Candelabra White-Label Widget Suite
# Obtain all values by contacting dxFeed / Devexperts: https://dxfeed.com
NEXT_PUBLIC_DXFEED_WIDGET_CDN_URL=
DXFEED_WIDGET_CDN_URL=
DXFEED_IPF_PATH=
DXFEED_IPF_AUTH_HEADER=
DXFEED_FEED_PATH=
DXFEED_FEED_AUTH_HEADER=
DXFEED_SCANNER_PATH=
DXFEED_SCANNER_AUTH_HEADER=
DXFEED_NEWS_PATH=
DXFEED_NEWS_AUTH_HEADER=
DXFEED_SCHEDULE_PATH=
DXFEED_TOKEN_EXCHANGE_URL=

# AI Trading Assistant
# Server-only - never exposed to the browser.
GEMINI_API_KEY=
AI_CHAT_DAILY_LIMIT=20
AI_CHART_DAILY_LIMIT=3
# Model IDs are environment-driven. Leave blank to use the built-in defaults.
AI_DEFAULT_MODEL=
AI_CHART_MODEL=
